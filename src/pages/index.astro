---
const R2_PUBLIC_URL = "https://pub-df215eae79ca46a2a27f03bec087cad1.r2.dev";

const wallpaperFiles = [
  "saturn_rings_space.jpg",
  "rainbow_minimalist_landscape.jpg",
  "sunflower_field_sunset.jpg",
  "sunflower_sunset_dream.jpg"
];

const wallpapers = wallpaperFiles.map((filename) => ({
  filename,
  title: filename
    .replace(/\.[^/.]+$/, "")
    .replace(/[-_]/g, " "),
  url: `${R2_PUBLIC_URL}/${filename}`
}));
---

<h1>Wallpapers 4K</h1>

<div id="gallery"></div>

<script define:vars={{ wallpapers }}>
  const gallery = document.getElementById("gallery");

  wallpapers.forEach((item) => {
    const img = document.createElement("img");

    img.src = item.url;
    img.alt = item.title;

    img.style.width = "300px";
    img.style.margin = "10px";

    gallery.appendChild(img);
  });
</script>
