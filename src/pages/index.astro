    name="description"
    content="Colección de fondos de pantalla 4K gratis para PC y celular."
  />
</head>

<body>

<header>

  <h1>Wallpapers 4K</h1>

  <p>
    Fondos de pantalla 4K gratis para PC y celular
  </p>

  <!-- BUSCADOR -->

  <div class="search-container">

    <input
      id="searchInput"
      type="search"
