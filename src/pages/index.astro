      ×
    </button>

  </div>

  <p id="resultsInfo"></p>

</header>


<main>

  <!-- GALERÍA -->

  <div id="gallery" class="gallery"></div>


  <!-- MENSAJE SIN RESULTADOS -->

  <div id="noResults" class="no-results">

    <div>🔍</div>

    <h2>No se encontraron wallpapers</h2>

    <p>
