const R2_PUBLIC_URL = "https://pub-df215eae79ca46a2a27f03bec087cad1.r2.dev";

// Sigue agregando aquí los nombres de tus imágenes de R2
const wallpaperFiles = [
  "saturn_rings_space.jpg",
  "rainbow_minimalist_landscape.jpg",
  "sunflower_field_sunset.jpg",
  "sunflower_sunset_dream.jpg"
];

function formatAltText(filename: string) {
  const nameWithoutExt =
    filename.substring(0, filename.lastIndexOf(".")) || filename;

  return nameWithoutExt
    .replace(/[-_]/g, " ")
    .replace(/\b\w/g, char => char.toUpperCase());
}

const wallpapers = wallpaperFiles.map((filename) => ({
  filename,
  title: formatAltText(filename),
  url: `${R2_PUBLIC_URL}/${filename}`
}));
