<script define:vars={{ wallpapers }}>

  // ==========================================
  // CONFIGURACIÓN
  // ==========================================

  const PER_PAGE = 20;

  let currentPage = 1;

  let filteredWallpapers = wallpapers;

  let currentImage = 0;


  // ==========================================
  // ELEMENTOS
  // ==========================================

  const gallery =
    document.getElementById("gallery");

  const searchInput =
    document.getElementById("searchInput");

  const clearSearch =
    document.getElementById("clearSearch");

  const resultsInfo =
    document.getElementById("resultsInfo");

  const pagination =
    document.getElementById("pagination");

  const prevPage =
    document.getElementById("prevPage");

  const nextPage =
    document.getElementById("nextPage");

  const pageNumber =
    document.getElementById("pageNumber");

  const noResults =
    document.getElementById("noResults");


  // LIGHTBOX

  const lightbox =
    document.getElementById("lightbox");

  const lightboxImg =
    document.getElementById("lightboxImg");

  const lightboxTitle =
    document.getElementById("lightboxTitle");

  const downloadBtn =
    document.getElementById("downloadBtn");

  const closeLightbox =
    document.getElementById("closeLightbox");

  const prevImage =
    document.getElementById("prevImage");

  const nextImage =
    document.getElementById("nextImage");


  // ==========================================
  // MOSTRAR GALERÍA
  // ==========================================

  function renderGallery() {

    gallery.innerHTML = "";


    // Si no hay resultados

    if (filteredWallpapers.length === 0) {

      gallery.style.display = "none";

      noResults.style.display = "block";

      pagination.style.display = "none";

      resultsInfo.textContent = "";

      return;

    }


    gallery.style.display = "grid";

    noResults.style.display = "none";

    pagination.style.display = "flex";


    // Total de páginas

    const totalPages =
      Math.ceil(
        filteredWallpapers.length / PER_PAGE
      );


    // Evitar páginas inexistentes

    if (currentPage > totalPages) {

      currentPage = totalPages;

    }


    // Primera imagen

    const start =
      (currentPage - 1) * PER_PAGE;


    // Última imagen

    const end =
      Math.min(
        start + PER_PAGE,
        filteredWallpapers.length
      );


    // Crear las tarjetas

    for (
      let i = start;
      i < end;
      i++
    ) {

      const item =
        filteredWallpapers[i];


      const card =
        document.createElement("article");

      card.className = "card";


      const img =
        document.createElement("img");

      img.src = item.url;

      img.alt = item.title;

      img.loading = "lazy";


      const overlay =
        document.createElement("div");

      overlay.className =
        "card-overlay";


      const title =
        document.createElement("span");

      title.textContent =
        item.title;


      overlay.appendChild(title);

      card.appendChild(img);

      card.appendChild(overlay);

      gallery.appendChild(card);


      // Abrir lightbox

      card.addEventListener(
        "click",
        () => {

          openLightbox(i);

        }
      );

    }


    // Información

    resultsInfo.textContent =
      `Mostrando ${start + 1}-${end} de ${filteredWallpapers.length} wallpapers`;


    // Página

    pageNumber.textContent =
      `Página ${currentPage} de ${totalPages}`;


    // Botones

    prevPage.disabled =
      currentPage === 1;

    nextPage.disabled =
      currentPage === totalPages;

  }


  // ==========================================
  // BUSCADOR
  // ==========================================

  searchInput.addEventListener(
    "input",
    () => {

      const search =
        searchInput.value
          .toLowerCase()
          .trim();


      // Mostrar / ocultar X

      if (search.length > 0) {

        clearSearch.style.display =
          "block";

      } else {

        clearSearch.style.display =
          "none";

      }


      // Filtrar

      filteredWallpapers =
        wallpapers.filter(
          (item) => {

            return item.title
              .toLowerCase()
              .includes(search);

          }
        );


      // Volver a página 1

      currentPage = 1;

      renderGallery();

    }
  );


  // Limpiar búsqueda

  clearSearch.addEventListener(
    "click",
    () => {

      searchInput.value = "";

      filteredWallpapers =
        wallpapers;

      currentPage = 1;

      clearSearch.style.display =
        "none";

      renderGallery();

      searchInput.focus();

    }
  );


  // ==========================================
  // SIGUIENTE PÁGINA
  // ==========================================

  nextPage.addEventListener(
    "click",
    () => {

      const totalPages =
        Math.ceil(
          filteredWallpapers.length / PER_PAGE
        );


      if (currentPage < totalPages) {

        currentPage++;

        renderGallery();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

      }

    }
  );


  // ==========================================
  // PÁGINA ANTERIOR
  // ==========================================

  prevPage.addEventListener(
    "click",
    () => {

      if (currentPage > 1) {

        currentPage--;

        renderGallery();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

      }

    }
  );


  // ==========================================
  // LIGHTBOX
  // ==========================================

  function openLightbox(index) {

    currentImage = index;

    updateLightbox();

    lightbox.classList.add("active");

    document.body.style.overflow =
      "hidden";

  }


  function updateLightbox() {

    const item =
      filteredWallpapers[currentImage];


    if (!item) return;


    lightboxImg.src =
      item.url;

    lightboxImg.alt =
      item.title;

    lightboxTitle.textContent =
      item.title;

    downloadBtn.href =
      item.url;

  }


  function closeModal() {

    lightbox.classList.remove("active");

    document.body.style.overflow =
      "auto";

  }


  // Imagen siguiente

  function showNextImage() {

    if (
      filteredWallpapers.length === 0
    ) return;


    currentImage =
      (
        currentImage + 1
      ) %
      filteredWallpapers.length;


    updateLightbox();

  }


  // Imagen anterior

  function showPrevImage() {

    if (
      filteredWallpapers.length === 0
    ) return;


    currentImage =
      (
        currentImage -
        1 +
        filteredWallpapers.length
      ) %
      filteredWallpapers.length;


    updateLightbox();

  }


  closeLightbox.addEventListener(
    "click",
    closeModal
  );


  nextImage.addEventListener(
    "click",
    showNextImage
  );


  prevImage.addEventListener(
    "click",
    showPrevImage
  );


  // Cerrar haciendo clic fuera

  lightbox.addEventListener(
    "click",
    (event) => {

      if (
        event.target === lightbox
      ) {

        closeModal();

      }

    }
  );


  // Teclado

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        !lightbox.classList.contains(
          "active"
        )
      ) return;


      if (
        event.key === "Escape"
      ) {

        closeModal();

      }


      if (
        event.key === "ArrowRight"
      ) {

        showNextImage();

      }


      if (
        event.key === "ArrowLeft"
      ) {

        showPrevImage();

      }

    }
  );


  // ==========================================
  // INICIAR
  // ==========================================

  clearSearch.style.display =
    "none";

  renderGallery();

</script>


