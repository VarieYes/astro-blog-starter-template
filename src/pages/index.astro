---
const R2_PUBLIC_URL = "https://pub-df215eae79ca46a2a27f03bec087cad1.r2.dev";

// Asegúrate de que los nombres coincidan exactamente con tus archivos en R2
const wallpaperFiles = [
  "saturn_rings_space.jpg",
  "rainbow_minimalist_landscape.jpg",
  "sunflower_field_sunset.jpg",
  "sunflower_sunset_dream.jpg"
];

function formatAltText(filename: string) {
  const nameWithoutExt = filename.substring(0, filename.lastIndexOf('.')) || filename;
  return nameWithoutExt
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, char => char.toUpperCase());
}

const wallpapers = wallpaperFiles.map(filename => ({
  filename,
  title: formatAltText(filename),
  url: `${R2_PUBLIC_URL}/${filename}`
}));
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Galería de Wallpapers 4K Ultra HD</title>
  <meta name="description" content="Colección de fondos de pantalla 4K gratis para PC y celular." />
</head>
<body>

  <header>
    <h1>Wallpapers 4K</h1>
    <p>Haz clic en cualquier imagen para verla en tamaño completo</p>

    <div class="search-wrapper">
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Buscar wallpaper por nombre..."
        autocomplete="off"
      />
    </div>
  </header>

  <main>
    <div class="gallery" id="gallery">
      {wallpapers.map((item, index) => (
        <article class="card" data-index={index} data-title={item.title.toLowerCase()}>
          <img src={item.url} alt={item.title} loading="lazy" />
          <div class="card-overlay">
            <span>{item.title}</span>
          </div>
        </article>
      ))}
    </div>

    <p id="no-results" class="no-results" hidden>No se encontraron wallpapers con ese nombre.</p>

    <div class="pagination" id="pagination">
      <button id="prev-page" class="page-btn" aria-label="Página anterior">&#10094;</button>
      <span id="page-indicator" class="page-indicator">Página 1</span>
      <button id="next-page" class="page-btn" aria-label="Página siguiente">&#10095;</button>
    </div>
  </main>

  <!-- Visualizador en Pantalla Completa (Lightbox Modal) -->
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button id="close-btn" class="close-btn" aria-label="Cerrar">&times;</button>
    <button id="prev-btn" class="nav-btn prev" aria-label="Anterior">&#10094;</button>

    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
      <div class="lightbox-footer">
        <h2 id="lightbox-title"></h2>
        <a id="download-btn" href="" download target="_blank" class="download-btn">Descargar 4K</a>
      </div>
    </div>

    <button id="next-btn" class="nav-btn next" aria-label="Siguiente">&#10095;</button>
  </div>

  <footer>
    <p>© 2026 Wallpapers 4K — Descargas directas de alta resolución</p>
  </footer>

  <script is:inline define:vars={{ wallpapers }}>
    const ITEMS_PER_PAGE = 20;

    let currentPage = 1;
    let filteredIndices = wallpapers.map((_, i) => i); // índices originales que pasan el filtro actual
    let currentLightboxPos = 0; // posición dentro de filteredIndices, para el lightbox

    const galleryEl = document.getElementById('gallery');
    const cards = Array.from(document.querySelectorAll('.card'));
    const searchInput = document.getElementById('search-input');
    const noResults = document.getElementById('no-results');

    const paginationEl = document.getElementById('pagination');
    const prevPageBtn = document.getElementById('prev-page');
    const nextPageBtn = document.getElementById('next-page');
    const pageIndicator = document.getElementById('page-indicator');

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const downloadBtn = document.getElementById('download-btn');
    const closeBtn = document.getElementById('close-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    // ---------- Filtro + Paginación ----------

    function applyFilter(query) {
      const q = query.trim().toLowerCase();
      filteredIndices = wallpapers
        .map((item, i) => ({ i, title: item.title.toLowerCase() }))
        .filter(entry => entry.title.includes(q))
        .map(entry => entry.i);
      currentPage = 1;
      renderPage();
    }

    function totalPages() {
      return Math.max(1, Math.ceil(filteredIndices.length / ITEMS_PER_PAGE));
    }

    function renderPage() {
      // Oculta todas las cards primero
      cards.forEach(card => { card.style.display = 'none'; });

      if (filteredIndices.length === 0) {
        noResults.hidden = false;
        paginationEl.hidden = true;
        return;
      }

      noResults.hidden = true;
      paginationEl.hidden = totalPages() <= 1;

      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;
      const pageIndices = filteredIndices.slice(start, end);

      pageIndices.forEach(originalIndex => {
        const card = cards[originalIndex];
        if (card) card.style.display = '';
      });

      pageIndicator.textContent = `Página ${currentPage} de ${totalPages()}`;
      prevPageBtn.disabled = currentPage <= 1;
      nextPageBtn.disabled = currentPage >= totalPages();

      // Vuelve arriba de la galería al cambiar de página
      galleryEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    searchInput.addEventListener('input', (e) => {
      applyFilter(e.target.value);
    });

    prevPageBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
      }
    });

    nextPageBtn.addEventListener('click', () => {
      if (currentPage < totalPages()) {
        currentPage++;
        renderPage();
      }
    });

    // ---------- Lightbox ----------

    function openLightbox(originalIndex) {
      const pos = filteredIndices.indexOf(originalIndex);
      currentLightboxPos = pos !== -1 ? pos : 0;
      updateLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = 'auto';
    }

    function updateLightbox() {
      const originalIndex = filteredIndices[currentLightboxPos];
      const current = wallpapers[originalIndex];
      lightboxImg.src = current.url;
      lightboxImg.alt = current.title;
      lightboxTitle.textContent = current.title;
      downloadBtn.href = current.url;
    }

    function showNext() {
      if (filteredIndices.length === 0) return;
      currentLightboxPos = (currentLightboxPos + 1) % filteredIndices.length;
      updateLightbox();
    }

    function showPrev() {
      if (filteredIndices.length === 0) return;
      currentLightboxPos = (currentLightboxPos - 1 + filteredIndices.length) % filteredIndices.length;
      updateLightbox();
    }

    // Eventos de las cards (delegación, funciona para todas aunque cambien de página)
    galleryEl.addEventListener('click', (e) => {
      const card = e.target.closest('.card');
      if (!card) return;
      const index = parseInt(card.getAttribute('data-index'), 10);
      openLightbox(index);
    });

    closeBtn.addEventListener('click', closeLightbox);
    nextBtn.addEventListener('click', showNext);
    prevBtn.addEventListener('click', showPrev);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Navegación con teclado
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });

    // Render inicial
    renderPage();
  </script>

</body>
</html>

<style>
  :root {
    --bg-color: #090d16;
    --card-bg: #151c2c;
    --accent: #38bdf8;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: system-ui, -apple-system, sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }

  header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  header p {
    color: var(--text-muted);
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .search-wrapper {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .search-input {
    width: 100%;
    max-width: 420px;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background-color: var(--card-bg);
    color: var(--text-main);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  main {
    flex: 1;
    padding: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background-color: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 9;
    cursor: pointer;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 25px -5px rgba(56, 189, 248, 0.15);
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .card:hover .card-overlay { opacity: 1; }

  .card-overlay span {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .no-results {
    text-align: center;
    color: var(--text-muted);
    padding: 3rem 1rem;
    font-size: 0.95rem;
  }

  /* Paginación */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .page-btn {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: var(--text-main);
    font-size: 1.1rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  .page-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.18);
  }

  .page-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .page-indicator {
    color: var(--text-muted);
    font-size: 0.9rem;
    min-width: 120px;
    text-align: center;
  }

  /* Lightbox Modal */
  .lightbox {
    position: fixed;
    inset: 0;
    background-color: rgba(5, 8, 15, 0.95);
    backdrop-filter: blur(12px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 70vh;
    border-radius: 12px;
    object-fit: contain;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  }

  .lightbox-footer {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .lightbox-footer h2 {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .download-btn {
    background-color: var(--accent);
    color: #0f172a;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: background-color 0.2s;
  }

  .download-btn:hover { background-color: #7dd3fc; }

  /* Controls */
  .close-btn {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    background: none;
    border: none;
    color: white;
    font-size: 2.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: white;
    font-size: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s;
  }

  .nav-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .nav-btn.prev { left: 2rem; }
  .nav-btn.next { right: 2rem; }

  footer {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .nav-btn.prev { left: 0.5rem; }
    .nav-btn.next { right: 0.5rem; }
    .lightbox-footer { flex-direction: column; gap: 0.75rem; }
  }
</style>
