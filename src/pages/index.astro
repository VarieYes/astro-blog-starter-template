    id="prevImage"
    class="nav-btn prev"
  >
    ❮
  </button>


  <div class="lightbox-content">

    <img
      id="lightboxImg"
      src=""
      alt=""
    />

    <div class="lightbox-footer">

      <h2 id="lightboxTitle"></h2>

      <a
        id="downloadBtn"
        class="download-btn"
